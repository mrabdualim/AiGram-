# AiGram Environment Variables

# ⚠️ ВАЖНО: Google Generative AI API Key
# AI больше НЕ работает в демо-режиме!
# Для работы AI-помощника Zud AI ОБЯЗАТЕЛЬНО нужен настоящий API ключ
# 
# Как получить ключ:
# 1. Перейдите: https://makersuite.google.com/app/apikey
# 2. Войдите с Google аккаунтом
# 3. Создайте новый API ключ
# 4. Вставьте его ниже (замените 'your_api_key_here')
#
# Без ключа AI не будет работать!
VITE_GEMINI_API_KEY=your_api_key_here

# App Configuration
VITE_APP_NAME=AiGram
VITE_APP_URL=http://localhost:3000
